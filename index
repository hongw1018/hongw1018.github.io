    <section id="resources">
        <h2>Academic Resources</h2>
        
        <h3>Research Tools</h3>
        <ul class="resource-list">
            <li><a href="#">Corpus of Urban Multilingualism</a> - A collection of transcribed interviews from multilingual communities</li>
            <li><a href="#">Code-switching Annotation Guidelines</a> - PDF documentation</li>
        </ul>
        
